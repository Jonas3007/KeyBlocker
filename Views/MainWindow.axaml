<Window
    x:Class="KeyBlocker.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KeyBlocker.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="400"
    Width="400"
    Height="600"
    x:DataType="vm:MainViewModel"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d"
    Title="KeyBlocker">
    <Design.DataContext>
        <!--
        This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at
        App.axaml.cs)
        -->
        <vm:MainViewModel />
    </Design.DataContext>
    <!-- Second Grid wich will house list of added key combos
    and a button to add new key combos -->
    <Grid Margin="5"
          Grid.Row="1"
          RowDefinitions="Auto,Auto,*,Auto">
        <!-- <Button x:Name="AddKeyComboButton"
                Grid.Row="0"
                MinHeight="44"
                HorizontalAlignment="Center"
                Margin="10"
                Padding="20,10"
                CornerRadius="1"
                BorderBrush="#48BB78"
                Background="#48BB78"
                Foreground="White"
                FontFamily="Noto Sans, Segoe UI, sans-serif"
                FontSize="17"
                FontWeight="SemiBold"
                Content="Add Key Combo"
                Command="{Binding AddKeyComboCommand}">
        </Button> -->
        <Grid
            Margin="0,0,0,10"
            Grid.Row="1"
            ColumnDefinitions="Auto,Auto,Auto" >
            <TextBox Grid.Column="0" Width="250"></TextBox>
            <Button Grid.Column="1"
                    Width="45"
             Height="35">Record</Button>
            <Button Height="35"
                    Width="45" 
                    Background="#48BB78"
                     Foreground="White"
                     HorizontalAlignment="Center"
                     Grid.Column="2"
                    >Add</Button>
        </Grid>
        <Border Grid.Row="2"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="1"
                Padding="10">
            <StackPanel Grid.Row="0"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
            </StackPanel>
        </Border>

        <TextBox Grid.Row="2"
                 Text="{Binding PressedKeys}"></TextBox>

    </Grid>


</Window>
